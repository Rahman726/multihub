# Copy this file to .env and edit as needed. Nothing here is required —
# without any of it the game uses the local Ollama model, falling back to
# the offline question bank.

# --- Option A: Z.ai (cloud AI, best quality, needs a key) ---
ZAI_API_KEY=
ZAI_API_BASE=https://api.z.ai/v1
ZAI_MODEL=glm-4.5-turbo

# --- Option B: local Ollama (free, no API key, no internet) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# qwen2.5:1.5b is fast (~15s per quiz); qwen2.5:7b is smarter but slower
OLLAMA_MODEL=qwen2.5:1.5b
# raise this if you use a bigger model (e.g. OLLAMA_TIMEOUT=240 for 7b)
OLLAMA_TIMEOUT=120
